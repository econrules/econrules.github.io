{
  "rules": {
    "rooms": {
      "$pin": {
        ".write": "auth != null && $pin.matches(/^[0-9]{6}$/) && (data.child('host').val() === auth.uid || (!data.exists() && newData.child('host').val() === auth.uid))",
        "host":    { ".read": "auth != null", ".validate": "newData.isString()" },
        "created": { ".validate": "newData.isNumber()" },
        "state":   { ".read": "auth != null" },
        "scores":  { ".read": "auth != null" },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('rooms').child($pin).child('state/phase').val() === 'lobby')",
            ".validate": "newData.hasChildren(['name', 'icon', 'joinedAt'])",
            "name":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 15" },
            "icon":     { ".validate": "newData.isString() && newData.val().matches(/^[a-z]{2,12}$/)" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "$other":   { ".validate": false }
          }
        },
        "answers": {
          ".read": "auth != null && root.child('rooms').child($pin).child('host').val() === auth.uid",
          "$qi": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms').child($pin).child('state/phase').val() === 'question' && root.child('rooms').child($pin).child('state/qs').val() === $qi",
              ".validate": "newData.hasChildren(['choice']) || newData.hasChildren(['order'])",
              "choice": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
              "order": {
                "$i":   { ".validate": "$i.matches(/^[0-5]$/) && newData.isString() && newData.val().length <= 120" }
              },
              "$other": { ".validate": false }
            }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
